generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  OFFER_MADE
  CLOSED_WON
  CLOSED_LOST
  NURTURING
}

enum PropertyType {
  APARTMENT
  HOUSE
  OFFICE
  COMMERCIAL
  LAND
  INDUSTRIAL
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
  RESERVED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
  INCOMPLETE
  TRIALING
}

enum VoiceCallStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?   // Hashed password for credentials provider
  role          UserRole  @default(CLIENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  agentProfile   AgentProfile?
  properties     Property[]
  leads          Lead[]
  appointments   Appointment[]
  voiceCalls     VoiceCall[]
  subscription   Subscription?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AgentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String?
  bio         String?  @db.Text
  agencyName  String?
  license     String?
  website     String?
  timezone    String   @default("America/Mexico_City")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model Property {
  id          String         @id @default(cuid())
  agentId     String
  title       String
  description String?        @db.Text
  type        PropertyType
  status      PropertyStatus @default(FOR_SALE)
  price       Decimal        @db.Decimal(14, 2)
  currency    String         @default("USD")
  address     String
  city        String
  state       String
  zipCode     String?
  country     String         @default("México")
  bedrooms    Int?
  bathrooms   Int?
  sqm         Float?
  lotSize     Float?
  yearBuilt   Int?
  features    String[]       @default([])
  images      String[]       @default([])
  isFeatured  Boolean        @default(false)
  isPublished Boolean        @default(true)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agent       User          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  voiceCalls   VoiceCall[]

  @@map("properties")
}

model Lead {
  id              String     @id @default(cuid())
  agentId         String
  name            String
  email           String
  phone           String?
  source          String     @default("web") // web, voice, referral, social
  status          LeadStatus @default(NEW)
  budgetMin       Decimal?   @db.Decimal(14, 2)
  budgetMax       Decimal?   @db.Decimal(14, 2)
  preferredType   PropertyType?
  preferredCity   String?
  notes           String?    @db.Text
  aiScore         Int?       @db.SmallInt // 0-100 qualification score
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agent        User          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  voiceCalls   VoiceCall[]
  activities   LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String   // call, email, note, status_change
  content   String?  @db.Text
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model Appointment {
  id          String            @id @default(cuid())
  agentId     String
  leadId      String
  propertyId  String?
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  type        String            @default("visit") // visit, call, video
  notes       String?           @db.Text
  aiConfirmed Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  agent    User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("appointments")
}

model VoiceCall {
  id              String          @id @default(cuid())
  agentId         String
  leadId          String?
  propertyId      String?
  externalCallId  String?         @unique
  status          VoiceCallStatus @default(SCHEDULED)
  direction       String          @default("outbound") // inbound, outbound
  transcript      String?         @db.Text
  summary         String?         @db.Text
  recordingUrl    String?
  durationSeconds Int?
  aiScore         Int?            @db.SmallInt
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  agent    User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("voice_calls")
}

model Subscription {
  id                   String            @id @default(cuid())
  userId               String            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  plan                 String            @default("basic")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
